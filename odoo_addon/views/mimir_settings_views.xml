<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mimir" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mimir</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Mimir" data-string="Mimir" name="mimir">
                    <block title="Access" invisible="mimir_external_api_key">
                        <div class="alert alert-info d-flex align-items-center gap-3 mx-3 mt-2 mb-3" role="alert">
                            <i class="fa fa-key fa-2x text-primary"/>
                            <div>
                                <strong>Mimir requires an access token to operate.</strong>
                                <br/>
                                Paste your API key below, or
                                <a href="https://datastruct.tech/mimir/request" target="_blank" class="alert-link">
                                    request one here →
                                </a>
                            </div>
                        </div>
                        <setting string="API Key" help="Paste the UUID token you received by email">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_external_api_key"/>
                                    <field name="mimir_external_api_key" class="col-lg-6" placeholder="123e4567-e89b-12d3-a456-426614174000"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Replenishment Import" invisible="not mimir_external_api_key">
                        <setting string="Enable Mimir" help="Turn on warehouse-scoped replenishment rule imports">
                            <field name="mimir_enabled"/>
                        </setting>
                        <setting string="Warehouse" help="Mimir imports and stages one warehouse at a time">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_warehouse_id"/>
                                    <field name="mimir_warehouse_id" class="col-lg-6" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Integration" invisible="not mimir_enabled or not mimir_external_api_key">
                        <setting string="Input Source" help="Where to read the parqcast export bundle from">
                            <field name="mimir_input_source" widget="radio"/>
                        </setting>
                        <setting string="Odoo Attachments"
                                 help="Mimir reads directly from the latest Parqcast export run's attachments."
                                 invisible="mimir_input_source != 'attachment'">
                            <div class="text-muted">
                                Reads parquet files from the latest completed Parqcast export.
                                Rule and evidence outputs are stored as attachments on the run record.
                            </div>
                        </setting>
                        <setting string="Parquet Directories" help="Server file paths for parqcast input and Mimir output"
                                 invisible="mimir_input_source != 'filesystem'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_parquet_input_dir"/>
                                    <field name="mimir_parquet_input_dir" class="col-lg-6" placeholder="/data/parqcast/exports/latest"/>
                                </div>
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_parquet_output_dir"/>
                                    <field name="mimir_parquet_output_dir" class="col-lg-6" placeholder="/data/mimir/output"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="S3 Configuration"
                                 help="Read Parqcast exports directly from an S3-compatible bucket"
                                 invisible="mimir_input_source != 's3'">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_s3_bucket"/>
                                    <field name="mimir_s3_bucket" class="col-lg-6" placeholder="parqcast-v18-demo"/>
                                </div>
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_s3_prefix"/>
                                    <field name="mimir_s3_prefix" class="col-lg-6" placeholder="parqcast"/>
                                </div>
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_s3_endpoint_url"/>
                                    <field name="mimir_s3_endpoint_url" class="col-lg-6" placeholder="https://s3.datastruct.tech"/>
                                </div>
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_s3_access_key_id"/>
                                    <field name="mimir_s3_access_key_id" class="col-lg-6"/>
                                </div>
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_s3_secret_access_key"/>
                                    <field name="mimir_s3_secret_access_key" password="True" class="col-lg-6"/>
                                </div>
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_s3_region"/>
                                    <field name="mimir_s3_region" class="col-lg-3" placeholder="eu-central-1"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="External Rules Server"
                                 help="Optional. If configured, Mimir fetches warehouse-scoped min/max and forecast evidence from this server.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_external_forecast_uri"/>
                                    <field name="mimir_external_forecast_uri" class="col-lg-6" placeholder="https://mimir.datastruct.tech"/>
                                </div>
                                <div class="row mt-2">
                                    <label class="col-lg-3" for="mimir_external_api_key"/>
                                    <field name="mimir_external_api_key" password="True" class="col-lg-6" placeholder="123e4567-e89b-12d3-a456-426614174000"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Auto-push to Orderpoints" help="Automatically approve imported rules after each run">
                            <field name="mimir_auto_push"/>
                        </setting>
                        <setting string="Run Import" help="Import rules for the selected warehouse and stage them for review">
                            <button name="action_run_mimir" type="object"
                                    string="Run Now" class="btn-primary"
                                    icon="fa-play"
                                    confirm="Import replenishment rules for the selected warehouse now?"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
