<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="foreqcast_decision_request_view_list" model="ir.ui.view">
        <field name="name">foreqcast.decision.request.list</field>
        <field name="model">foreqcast.decision.request</field>
        <field name="arch" type="xml">
            <list string="Decision Requests" decoration-info="status == 'draft'" decoration-warning="status == 'review'" decoration-success="status == 'approved'" decoration-muted="status == 'rejected'">
                <field name="run_id"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="proposed_min_qty"/>
                <field name="proposed_max_qty"/>
                <field name="current_min_qty"/>
                <field name="current_max_qty"/>
                <field name="planned_lead_time"/>
                <field name="empirical_lead_time"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'review'" decoration-success="status == 'approved'" decoration-muted="status == 'rejected'"/>
                <button name="action_approve" type="object" string="Approve" class="btn-success" invisible="status in ('approved', 'rejected')"/>
                <button name="action_review" type="object" string="Mark Review" class="btn-warning" invisible="status != 'draft'"/>
                <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="status in ('approved', 'rejected')"/>
            </list>
        </field>
    </record>

    <record id="foreqcast_decision_request_view_form" model="ir.ui.view">
        <field name="name">foreqcast.decision.request.form</field>
        <field name="model">foreqcast.decision.request</field>
        <field name="arch" type="xml">
            <form string="Decision Request">
                <header>
                    <button name="action_approve" type="object" string="Approve &amp; Apply" class="btn-primary" invisible="status in ('approved', 'rejected')"/>
                    <button name="action_review" type="object" string="Needs Review" invisible="status != 'draft'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="status in ('approved', 'rejected')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,review,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Proposed Changes">
                            <field name="proposed_min_qty"/>
                            <field name="proposed_max_qty"/>
                            <field name="planned_lead_time"/>
                            <field name="empirical_lead_time"/>
                        </group>
                        <group string="Current Values">
                            <field name="current_min_qty"/>
                            <field name="current_max_qty"/>
                            <field name="location_id"/>
                            <field name="run_id"/>
                            <field name="decision_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="foreqcast_decision_request_action" model="ir.actions.act_window">
        <field name="name">Decision Requests</field>
        <field name="res_model">foreqcast.decision.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_status': 'draft'}</field>
    </record>

    <menuitem id="foreqcast_menu_decisions" name="Decisions" parent="foreqcast_menu_root" action="foreqcast_decision_request_action" sequence="20"/>
</odoo>
