<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category Overrides -->
    <record id="foreqcast_category_override_view_list" model="ir.ui.view">
        <field name="name">foreqcast.category.override.list</field>
        <field name="model">foreqcast.category.override</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="category_id"/>
                <field name="service_level"/>
                <field name="safety_factor"/>
                <field name="lead_time_override_days"/>
                <field name="review_period_override_days"/>
                <field name="excluded"/>
            </list>
        </field>
    </record>

    <record id="foreqcast_category_override_action" model="ir.actions.act_window">
        <field name="name">Category Overrides</field>
        <field name="res_model">foreqcast.category.override</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Product Overrides -->
    <record id="foreqcast_product_override_view_list" model="ir.ui.view">
        <field name="name">foreqcast.product.override.list</field>
        <field name="model">foreqcast.product.override</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="service_level"/>
                <field name="safety_factor"/>
                <field name="min_qty_floor"/>
                <field name="max_qty_ceiling"/>
                <field name="lead_time_override_days"/>
                <field name="excluded"/>
            </list>
        </field>
    </record>

    <record id="foreqcast_product_override_action" model="ir.actions.act_window">
        <field name="name">Product Overrides</field>
        <field name="res_model">foreqcast.product.override</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="foreqcast_menu_overrides" name="Overrides" parent="foreqcast_menu_root" sequence="30"/>
    <menuitem id="foreqcast_menu_category_override" name="Category Overrides" parent="foreqcast_menu_overrides" action="foreqcast_category_override_action" sequence="10"/>
    <menuitem id="foreqcast_menu_product_override" name="Product Overrides" parent="foreqcast_menu_overrides" action="foreqcast_product_override_action" sequence="20"/>
</odoo>
