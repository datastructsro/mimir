<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="mimir_run_view_list" model="ir.ui.view">
        <field name="name">mimir.run.list</field>
        <field name="model">mimir.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="run_date"/>
                <field name="status" decoration-success="status == 'complete'" decoration-danger="status == 'error'" decoration-info="status == 'running'" widget="badge"/>
                <field name="warehouse_id"/>
                <field name="parquet_source_dir" string="Input"/>
                <field name="products_analyzed" string="Rules"/>
                <field name="products_forecasted"/>
                <field name="rules_created"/>
                <field name="rules_updated"/>
                <field name="rules_skipped"/>
                <field name="attachment_count" string="Files"/>
                <field name="duration_seconds" widget="float_time"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="mimir_run_view_form" model="ir.ui.view">
        <field name="name">mimir.run.form</field>
        <field name="model">mimir.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download_all_zip" type="object"
                            string="Download All (ZIP)" class="btn-primary" icon="fa-download"
                            invisible="status != 'complete' or attachment_count == 0"/>
                    <button name="action_download_excel" type="object"
                            string="Download Rules Excel" class="btn-secondary" icon="fa-file-excel-o"
                            invisible="status != 'complete' or attachment_count == 0"/>
                    <button name="action_download_rules" type="object"
                            string="Download Rules Parquet" class="btn-secondary" icon="fa-table"
                            invisible="status != 'complete' or attachment_count == 0"/>
                    <button name="action_download_forecast" type="object"
                            string="Download Forecast Excel" class="btn-secondary" icon="fa-line-chart"
                            invisible="status != 'complete' or attachment_count == 0"/>
                    <button name="action_open_excel_wizard" type="object"
                            string="Upload Excel Review" class="btn-secondary" icon="fa-upload"
                            invisible="status != 'complete'"/>
                    <field name="status" widget="statusbar" statusbar_visible="running,complete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_decisions" type="object" class="oe_stat_button" icon="fa-list" invisible="status != 'complete'">
                            <field name="decision_count" widget="statinfo" string="Decisions"/>
                        </button>
                    </div>
                    <group>
                        <group string="Run Info">
                            <field name="run_date"/>
                            <field name="warehouse_id"/>
                            <field name="parquet_source_dir" string="Input Source"/>
                            <field name="duration_seconds"/>
                            <field name="attachment_count"/>
                        </group>
                        <group string="Artifacts">
                            <div class="text-muted">
                                Rules are imported from <code>minmax.parquet</code>.
                                Forecast data is retained only as Excel evidence for the selected warehouse.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Results">
                            <field name="products_analyzed" string="Rules Imported"/>
                            <field name="products_forecasted"/>
                            <field name="rules_created"/>
                            <field name="rules_updated"/>
                            <field name="rules_skipped"/>
                        </group>
                    </group>
                    <group string="Error" invisible="status != 'error'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="mimir_run_action" model="ir.actions.act_window">
        <field name="name">Mimir Runs</field>
        <field name="res_model">mimir.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="mimir_menu_root" name="Mimir" web_icon="mimir,static/description/icon.png" sequence="90"/>
    <menuitem id="mimir_menu_runs" name="Runs" parent="mimir_menu_root" action="mimir_run_action" sequence="10"/>
</odoo>
