#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_service_level
msgid "Target fill rate (0.0-1.0). Set to 0.90 for standard service or 0.95 for critical items. Higher values require more safety stock. Start at 0.85 and increase per category as needed."
msgstr "Docelowy współczynnik realizacji (0,0–1,0). Ustaw 0,90 dla standardowej obsługi lub 0,95 dla pozycji krytycznych. Wyższe wartości wymagają większego zapasu bezpieczeństwa. Zacznij od 0,85 i zwiększaj w poszczególnych kategoriach w razie potrzeby."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_review_period_days
msgid "Days between replenishment reviews — affects max_qty calculation"
msgstr "Dni między przeglądami uzupełnień — wpływa na obliczenie max_qty"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_default_lead_time
msgid "Fallback lead time when no supplier info exists for a product"
msgstr "Awaryjny czas realizacji, gdy dla produktu brak danych o dostawcy"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_min_data_points
msgid "Minimum number of observations required to fit a regression"
