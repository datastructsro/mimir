#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_include_outgoing
msgid "Subtract confirmed SO quantities. Off by default to avoid double-counting with forecast."
msgstr "Oduzmi potvrđene količine prodajnih naloga. Isključeno prema zadanom kako bi se izbjeglo dvostruko računanje s prognozom."

