#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_service_level
msgid "Target fill rate (0.0-1.0). Set to 0.90 for standard service or 0.95 for critical items. Higher values require more safety stock. Start at 0.85 and increase per category as needed."
msgstr "Taxa de preenchimento alvo (0,0-1,0). Defina 0,90 para serviço padrão ou 0,95 para itens críticos. Valores mais altos requerem mais stock de segurança. Comece com 0,85 e aumente por categoria conforme necessário."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_review_period_days
msgid "Days between replenishment reviews — affects max_qty calculation"
msgstr "Dias entre revisões de reabastecimento — afeta o cálculo de max_qty"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_default_lead_time
msgid "Fallback lead time when no supplier info exists for a product"
msgstr "Prazo de entrega de reserva quando não existem informações de fornecedor para um produto"

