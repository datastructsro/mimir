#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_config_db_path
msgid "Path to foreqcast SQLite config database (for per-product overrides)"
msgstr "A Foreqcast SQLite konfigurációs adatbázis elérési útja (termékenkénti felülbírálásokhoz)"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_inventory_mode
msgid "How to account for current inventory when computing replenishment rules"
msgstr "Hogyan vegye figyelembe az aktuális készletet a feltöltési szabályok számításakor"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_respect_reservations
msgid "Subtract reserved quantities from on-hand (conservative). Disable to let planner reallocate all stock."
msgstr "Foglalt mennyiségek levonása a kézi készletből (konzervatív). Tiltsa le, hogy a tervező az összes készletet újra elosztja."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_include_incoming
msgid "Count open PO and in-transit quantities as available inventory"
msgstr "Nyitott beszerzési rendelések és szállítás alatti mennyiségek elérhető készletként számítása"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_include_outgoing
msgid "Subtract confirmed SO quantities. Off by default to avoid double-counting with forecast."
msgstr "Visszaigazolt vevői rendelési mennyiségek levonása. Alapértelmezés szerint ki van kapcsolva az előrejelzéssel való dupla számolás elkerülése érdekében."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_overstock_days
msgid "Products with more than this many days of coverage are flagged as overstock"
msgstr "Az ennél több napnyi fedezettséggel rendelkező termékek túlkészletezettként jelölődnek"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_understock_days
msgid "Products with fewer than this many days of coverage are flagged as understock"
msgstr "Az ennél kevesebb napnyi fedezettséggel rendelkező termékek alulkészletezettként jelölődnek"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_overstock_skip
msgid "In adjust mode, don't create orderpoints for overstocked products"
msgstr "Igazítás módban ne hozzon létre rendelési pontokat túlkészletezett termékekhez"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_understock_bump
msgid "In adjust mode, raise service level by this amount for understocked products (e.g. 0.95 → 0.98)"
msgstr "Igazítás módban emelje a kiszolgálási szintet ennyivel az alulkészletezett termékeknél (pl. 0,95 → 0,98)"

