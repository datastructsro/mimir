msgstr "Συνημμένα Odoo"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Foreqcast reads directly from the latest Parqcast export run's attachments. No file paths needed."
msgstr "Το Foreqcast διαβάζει απευθείας από τα συνημμένα της τελευταίας εξαγωγής Parqcast. Δεν χρειάζονται διαδρομές αρχείων."

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Reads parquet files from the latest completed Parqcast export. Output files are stored as attachments on the Forecast Run record."
msgstr "Διαβάζει αρχεία parquet από την τελευταία ολοκληρωμένη εξαγωγή Parqcast. Τα αρχεία εξόδου αποθηκεύονται ως συνημμένα στην εγγραφή εκτέλεσης πρόβλεψης."

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Parquet Directories"
msgstr "Κατάλογοι Parquet"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Server file paths for parqcast input and forecast output"
msgstr "Διαδρομές αρχείων διακομιστή για είσοδο Parqcast και έξοδο πρόβλεψης"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
