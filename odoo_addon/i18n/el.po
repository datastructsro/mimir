#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_horizon_days
msgid "Number of days to project demand forward"
msgstr "Αριθμός ημερών για προβολή ζήτησης μπροστά"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_time_bucket
msgid "Granularity of demand aggregation"
msgstr "Ανάλυση συγκέντρωσης ζήτησης"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_service_level
msgid "Target fill rate (0.0-1.0). Set to 0.90 for standard service or 0.95 for critical items. Higher values require more safety stock. Start at 0.85 and increase per category as needed."
msgstr "Στόχος ποσοστού πλήρωσης (0,0-1,0). Ορίστε 0,90 για τυπική εξυπηρέτηση ή 0,95 για κρίσιμα είδη. Υψηλότερες τιμές απαιτούν περισσότερο απόθεμα ασφαλείας. Ξεκινήστε από 0,85 και αυξήστε ανά κατηγορία ανάλογα με τις ανάγκες."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_review_period_days
msgid "Days between replenishment reviews — affects max_qty calculation"
msgstr "Ημέρες μεταξύ αναθεωρήσεων αναπλήρωσης — επηρεάζει τον υπολογισμό max_qty"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_default_lead_time
msgid "Fallback lead time when no supplier info exists for a product"
msgstr "Εφεδρικός χρόνος παράδοσης όταν δεν υπάρχουν πληροφορίες προμηθευτή για ένα προϊόν"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_min_data_points
msgid "Minimum number of observations required to fit a regression"
msgstr "Ελάχιστος αριθμός παρατηρήσεων που απαιτούνται για προσαρμογή παλινδρόμησης"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_min_demand_threshold
msgid "Skip products with average daily demand below this value"
msgstr "Παράλειψη προϊόντων με μέση ημερήσια ζήτηση κάτω από αυτή την τιμή"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_auto_push
msgid "Automatically update orderpoints after forecast run (vs. parquet-only)"
msgstr "Αυτόματη ενημέρωση σημείων παραγγελίας μετά την εκτέλεση πρόβλεψης (έναντι μόνο parquet)"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_parquet_input_dir
msgid "Path to parqcast export directory"
msgstr "Διαδρομή προς τον κατάλογο εξαγωγής Parqcast"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_parquet_output_dir
msgid "Path to write forecast and rules parquet files"
msgstr "Διαδρομή για εγγραφή αρχείων parquet πρόβλεψης και κανόνων"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_config_db_path
msgid "Path to foreqcast SQLite config database (for per-product overrides)"
msgstr "Διαδρομή προς τη βάση δεδομένων ρυθμίσεων SQLite Foreqcast (για παρακάμψεις ανά προϊόν)"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_inventory_mode
msgid "How to account for current inventory when computing replenishment rules"
msgstr "Πώς να ληφθεί υπόψη το τρέχον απόθεμα κατά τον υπολογισμό κανόνων αναπλήρωσης"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_respect_reservations
msgid "Subtract reserved quantities from on-hand (conservative). Disable to let planner reallocate all stock."
msgstr "Αφαίρεση δεσμευμένων ποσοτήτων από το διαθέσιμο απόθεμα (συντηρητικό). Απενεργοποιήστε για να αφήσετε τον σχεδιαστή να ανακατανείμει όλο το απόθεμα."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_include_incoming
msgid "Count open PO and in-transit quantities as available inventory"
msgstr "Υπολογισμός ανοικτών παραγγελιών αγοράς και ποσοτήτων σε μεταφορά ως διαθέσιμο απόθεμα"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_include_outgoing
msgid "Subtract confirmed SO quantities. Off by default to avoid double-counting with forecast."
msgstr "Αφαίρεση επιβεβαιωμένων ποσοτήτων παραγγελιών πώλησης. Απενεργοποιημένο εξ ορισμού για αποφυγή διπλού υπολογισμού με την πρόβλεψη."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_overstock_days
msgid "Products with more than this many days of coverage are flagged as overstock"
msgstr "Προϊόντα με περισσότερες από αυτές τις ημέρες κάλυψης επισημαίνονται ως υπεραπόθεμα"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_understock_days
msgid "Products with fewer than this many days of coverage are flagged as understock"
msgstr "Προϊόντα με λιγότερες από αυτές τις ημέρες κάλυψης επισημαίνονται ως υποαπόθεμα"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_overstock_skip
msgid "In adjust mode, don't create orderpoints for overstocked products"
msgstr "Σε λειτουργία προσαρμογής, μη δημιουργείτε σημεία παραγγελίας για προϊόντα με υπεραπόθεμα"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_understock_bump
msgid "In adjust mode, raise service level by this amount for understocked products (e.g. 0.95 → 0.98)"
msgstr "Σε λειτουργία προσαρμογής, αυξήστε το επίπεδο εξυπηρέτησης κατά αυτό το ποσό για προϊόντα με υποαπόθεμα (π.χ. 0,95 → 0,98)"

#. module: foreqcast
