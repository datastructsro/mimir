#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Target fill rate. Set to 0.90 for standard service or 0.95 for critical items. Higher values need more safety stock."
msgstr "Στόχος ποσοστού πλήρωσης. Ορίστε 0,90 για τυπική εξυπηρέτηση ή 0,95 για κρίσιμα είδη. Υψηλότερες τιμές χρειάζονται περισσότερο απόθεμα ασφαλείας."

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Review Period"
msgstr "Περίοδος αναθεώρησης"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Days between replenishment checks (affects max qty)"
msgstr "Ημέρες μεταξύ ελέγχων αναπλήρωσης (επηρεάζει μέγιστη ποσότητα)"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Default Lead Time"
msgstr "Προεπιλεγμένος χρόνος παράδοσης"

#. module: foreqcast
