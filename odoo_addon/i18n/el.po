#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Data Quality"
msgstr "Ποιότητα δεδομένων"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Require at least this many observations to forecast"
msgstr "Απαίτηση τουλάχιστον τόσων παρατηρήσεων για πρόβλεψη"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
msgid "Skip products with daily demand below this"
msgstr "Παράλειψη προϊόντων με ημερήσια ζήτηση κάτω από αυτό"

#. module: foreqcast
#: model:ir.ui.view,arch_db:foreqcast.res_config_settings_view_form_foreqcast
