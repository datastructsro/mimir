#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_respect_reservations
msgid "Subtract reserved quantities from on-hand (conservative). Disable to let planner reallocate all stock."
msgstr "Vähennä varatut määrät käsivarastosta (varovainen). Poista käytöstä, jotta suunnittelija voi kohdentaa kaiken varaston uudelleen."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_include_incoming
msgid "Count open PO and in-transit quantities as available inventory"
msgstr "Laske avoimet ostotilaukset ja kuljetuksessa olevat määrät käytettävissä olevaksi varastoksi"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_include_outgoing
msgid "Subtract confirmed SO quantities. Off by default to avoid double-counting with forecast."
msgstr "Vähennä vahvistetut myyntitilausmäärät. Oletuksena pois päältä ennusteen kaksinkertaisen laskennan välttämiseksi."

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_overstock_days
msgid "Products with more than this many days of coverage are flagged as overstock"
msgstr "Tuotteet, joilla on tätä enemmän kattavuuspäiviä, merkitään ylivarastoiduiksi"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_understock_days
msgid "Products with fewer than this many days of coverage are flagged as understock"
msgstr "Tuotteet, joilla on tätä vähemmän kattavuuspäiviä, merkitään alivarastoiduiksi"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_overstock_skip
msgid "In adjust mode, don't create orderpoints for overstocked products"
msgstr "Säätötilassa älä luo tilauspisteitä ylivarastoiduille tuotteille"

#. module: foreqcast
#: model:ir.model.fields,help:foreqcast.field_res_config_settings__foreqcast_understock_bump
msgid "In adjust mode, raise service level by this amount for understocked products (e.g. 0.95 → 0.98)"
msgstr "Säätötilassa nosta palvelutasoa tällä määrällä alivarastoiduille tuotteille (esim. 0,95 → 0,98)"

